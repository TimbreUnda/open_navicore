+// Decoded route data per OBF block, shared by every routing context of the
+// process. unloadAllData() (called before each HH detailed segment and each
+// start/end search) used to throw the decoded roads away and decode the same
+// blocks again; only the RouteSegment wrappers, which carry the search
+// state, need to be rebuilt. Objects are kept as decoded, before acceptLine()
+// and exclusions, which still run on every load. Not used when conditional
+// tags or direction points modify the objects.
+struct DecodedRouteDataCache {
+	typedef std::pair<const void*, int64_t> Key;
+	struct KeyHash {
+		size_t operator()(const Key& k) const {
+			return std::hash<const void*>()(k.first) ^ (std::hash<int64_t>()(k.second) * 31);
+		}
+	};
+	std::mutex mutex;
+	UNORDERED(map)<Key, std::vector<SHARED_PTR<RouteDataObject>>, KeyHash> blocks;
+	size_t bytes = 0;
+	static const size_t LIMIT = 48u << 20;
+
+	static DecodedRouteDataCache& instance() {
+		static DecodedRouteDataCache cache;
+		return cache;
+	}
+	bool get(const Key& key, std::vector<SHARED_PTR<RouteDataObject>>& out) {
+		std::lock_guard<std::mutex> lock(mutex);
+		auto it = blocks.find(key);
+		if (it == blocks.end()) return false;
+		out = it->second;
+		return true;
+	}
+	void put(const Key& key, const std::vector<SHARED_PTR<RouteDataObject>>& objects) {
+		size_t size = 0;
+		for (auto& o : objects) size += o->getSize();
+		std::lock_guard<std::mutex> lock(mutex);
+		if (bytes + size > LIMIT) {
+			blocks.clear();
+			bytes = 0;
+		}
+		if (blocks.emplace(key, objects).second) bytes += size;
+	}
+};
+
