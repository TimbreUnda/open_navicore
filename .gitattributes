* text=auto eol=lf

*.c text diff=cpp
*.h text diff=cpp
*.cpp text diff=cpp
*.S text diff=cpp
# Historical evidence includes reviewed CRLF files. Preserve their bytes while
# still letting Git's content detector provide ordinary textual diffs.
*.csv -text
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf

*.bmp binary
*.png binary
*.so binary
